        {
          "albumId": "016-the-clash-london-calling-7d75cf05",
          "trackTitle": "The Right Profile",
          "factIndex": 0,
          "refIndex": 0,
          "retainedExtract": "“The Right Profile,” Strummer’s wry and sad eulogy to Clift, is a rollicking anthem for a doomed figure who not coincidentally resembled Guy Stevens.",
          "section": {
            "kind": "character-offsets",
            "start": 3183,
            "end": 3332

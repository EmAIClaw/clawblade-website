        },
        {
          "albumId": "016-the-clash-london-calling-7d75cf05",
          "trackTitle": "Koka Kola",
          "factIndex": 0,
          "refIndex": 0,
          "retainedExtract": "The blink-and-you’ll-miss-it gem “Koka Kola” is an act of comic revenge against the encroaching advertising world, in the style of early Who, and its future colonization of both our whims and habits.",
          "section": {
            "kind": "character-offsets",
            "start": 7937,
            "end": 8136
          }
        },
        {
          "albumId": "016-the-clash-london-calling-7d75cf05",
          "trackTitle": "Four Horsemen",
          "factIndex": 0,
          "refIndex": 0,
          "retainedExtract": "“Four Horsemen” is a straightforward reaffirmation of Joe, Topper Headon, Paul Simonon, and Mick: the men making the music happen.",
          "section": {
            "kind": "character-offsets",
            "start": 8704,
            "end": 8834
          }
        },
        {
          "albumId": "016-the-clash-london-calling-7d75cf05",
          "trackTitle": "I'm Not Down",
          "factIndex": 0,
          "refIndex": 0,
          "retainedExtract": "“I’m Not Down” is the brilliant Jones-sung final word on all the misery and magic and possibility of the new great depression: “I’ve been beaten up / I’ve been thrown around / But I’m not down.”",
          "section": {
            "kind": "character-offsets",
            "start": 8835,
            "end": 9029
          }
        },
        {
          "albumId": "016-the-clash-london-calling-7d75cf05",
          "trackTitle": "Revolution Rock",
          "factIndex": 0,
          "refIndex": 0,

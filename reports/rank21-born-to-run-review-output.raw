    "adbcc3a88504c3ffbade1962cc9a213ef2d7bc21cd8cf8c342318b3bbba20d37": {
      "artifactId": "adbcc3a88504c3ffbade1962cc9a213ef2d7bc21cd8cf8c342318b3bbba20d37",
      "artifactSha256": "adbcc3a88504c3ffbade1962cc9a213ef2d7bc21cd8cf8c342318b3bbba20d37",
      "canonicalUrl": "https://en.wikipedia.org/wiki/Meeting_Across_the_River",
      "collectionMethod": "http-fetch",
      "collector": {
        "identity": "albumvault-http-collector",
        "runId": "rank21-born-to-run-http-collector-20260903",

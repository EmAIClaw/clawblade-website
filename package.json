{
  "name": "albumvault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "deploy:gym": "bash scripts/deploy-gym-via-github.sh",
    "test:security": "node scripts/test-security.mjs",
    "test:data": "node scripts/test-data-integrity.mjs",
    "test:listening": "node scripts/test-listening-enhancements.mjs",
    "test:loading": "node scripts/test-loading-recovery.mjs",
    "test:taste": "node scripts/test-taste-intelligence.mjs",
    "test:encyclopedia": "node scripts/test-encyclopedia-lazy-loading.mjs",
    "test:all": "npm run test:security && npm run test:data && npm run test:listening && npm run test:loading && npm run test:taste && npm run test:encyclopedia",
    "align:tracks": "node scripts/align-track-guides.mjs",
    "preview": "vite preview",
    "prepare:catalog": "node scripts/prepare-catalog.mjs",
    "prepare:catalog:offline": "node scripts/prepare-catalog.mjs --offline",
    "fill:covers": "node scripts/fill-missing-covers.mjs",
    "generate:encyclopedia": "node scripts/generate-encyclopedia.mjs",
    "repair:providers": "node scripts/repair-provider-matches.mjs",
    "repair:encyclopedia": "node scripts/repair-encyclopedia-facts.mjs",
    "enrich:albums": "node scripts/enrich-albums.mjs",
    "merge:enriched": "node scripts/merge-enriched.mjs",
    "enrich:full": "npm run enrich:albums && npm run merge:enriched",
    "curate:batch": "node scripts/batch-enrich.mjs",
    "curate:apply": "node scripts/apply-curated.mjs",
    "curate:full": "npm run curate:batch && npm run curate:apply",
    "prepare:data": "npm run prepare:catalog && npm run generate:encyclopedia"
  },
  "dependencies": {
    "@netlify/blobs": "^8.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.6.3",
    "vite": "^8.2.1"
  }
}
